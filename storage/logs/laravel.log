    \"<span class=sf-dump-key>content</span>\" => \"\"\"
      <span class=sf-dump-str title=\"7953 characters\">&lt;h3 style=&quot;text-align: center;&quot;&gt;Joining Letter&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;{date}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;{employee_name}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;{address}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Subject: Appointment for the post of {designation}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Dear {employee_name},&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;We are pleased to offer you the position of {designation} with {app_name} theCompany on the following terms and&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;conditions:&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;1. Commencement of employment&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Your employment will be effective, as of {start_date}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;2. Job title&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Your job title will be{designation}.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;3. Salary&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Your salary and other benefits will be as set out in Schedule 1, hereto.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;4. Place of posting&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;You will be posted at {branch}. You may however be required to work at any place of business which the Company has, or&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;may later acquire.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;5. Hours of Work&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;The normal working days are Monday through Friday. You will be required to work for such hours as necessary for the&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;proper discharge of your duties to the Company. The normal working hours are from {start_time} to {end_time} and you are&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;expected to work not less than {total_hours} hours each week, and if necessary for additional hours depending on your&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;responsibilities.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;6. Leave/Holidays&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;6.1 You are entitled to casual leave of 12 days.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;6.2 You are entitled to 12 working days of paid sick leave.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;6.3 The Company shall notify a list of declared holidays at the beginning of each year.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;7. Nature of duties&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;You will perform to the best of your ability all the duties as are inherent in your post and such additional duties as the company&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;may call upon you to perform, from time to time. Your specific duties are set out in Schedule II hereto.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;8. Company property&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;You will always maintain in good condition Company property, which may be entrusted to you for official use during the course of&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;your employment, and shall return all such property to the Company prior to relinquishment of your charge, failing which the cost&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;of the same will be recovered from you by the Company.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;9. Borrowing/accepting gifts&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;You will not borrow or accept any money, gift, reward, or compensation for your personal gains from or otherwise place yourself&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;under pecuniary obligation to any person/client with whom you may be having official dealings.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;10. Termination&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;10.1 Your appointment can be terminated by the Company, without any reason, by giving you not less than [Notice] months prior&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;notice in writing or salary in lieu thereof. For the purpose of this clause, salary shall mean basic salary.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;10.2 You may terminate your employment with the Company, without any cause, by giving no less than [Employee Notice]&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;months prior notice or salary for the unsaved period, left after adjustment of pending leaves, as on date.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;10.3 The Company reserves the right to terminate your employment summarily without any notice period or termination payment&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;if it has reasonable ground to believe you are guilty of misconduct or negligence, or have committed any fundamental breach of&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;contract, or caused any loss to the Company.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;10. 4 On the termination of your employment for whatever reason, you will return to the Company all property; documents, and&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;paper, both original and copies thereof, including any samples, literature, contracts, records, lists, drawings, blueprints,&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;letters, notes, data and the like; and Confidential Information, in your possession or under your control relating to your&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;employment or to clients business affairs.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11. Confidential Information&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11. 1 During your employment with the Company you will devote your whole time, attention, and skill to the best of your ability for&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;its business. You shall not, directly or indirectly, engage or associate yourself with, be connected with, concerned, employed, or&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;time or pursue any course of study whatsoever, without the prior permission of the Company.engaged in any other business or&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;activities or any other post or work part-time or pursue any course of study whatsoever, without the prior permission of the&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Company.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11.2 You must always maintain the highest degree of confidentiality and keep as confidential the records, documents, and other&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Confidential Information relating to the business of the Company which may be known to you or confided in you by any means&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;and you will use such records, documents and information only in a duly authorized manner in the interest of the Company. For&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;the purposes of this clauseConfidential Information means information about the Companys business and that of its customers&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;which is not available to the general public and which may be learned by you in the course of your employment. This includes,&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;but is not limited to, information relating to the organization, its customer lists, employment policies, personnel, and information&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;about the Companys products, processes including ideas, concepts, projections, technology, manuals, drawing, designs,&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;specifications, and all papers, resumes, records and other documents containing such Confidential Information.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11.3 At no time, will you remove any Confidential Information from the office without permission.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11.4 Your duty to safeguard and not disclos&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;e Confidential Information will survive the expiration or termination of this Agreement and/or your employment with the Company.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;11.5 Breach of the conditions of this clause will render you liable to summary dismissal under the clause above in addition to any&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;other remedy the Company may have against you in law.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;12. Notices&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Notices may be given by you to the Company at its registered office address. Notices may be given by the Company to you at&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;the address intimated by you in the official records.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;13. Applicability of Company Policy&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;The Company shall be entitled to make policy declarations from time to time pertaining to matters like leave entitlement,maternity&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;leave, employees benefits, working hours, transfer policies, etc., and may alter the same from time to time at its sole discretion.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;All such policy decisions of the Company shall be binding on you and shall override this Agreement to that extent.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;14. Governing Law/Jurisdiction&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Your employment with the Company is subject to Country laws. All disputes shall be subject to the jurisdiction of High Court&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Gujarat only.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;15. Acceptance of our offer&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Please confirm your acceptance of this Contract of Employment by signing and returning the duplicate copy.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;We welcome you and look forward to receiving your acceptance and to working with you.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;Yours Sincerely,&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;{app_name}&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"7953 characters\">            &lt;p&gt;{date}&lt;/p&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>created_by</span>\" => <span class=sf-dump-num>2</span>
    \"<span class=sf-dump-key>created_at</span>\" => \"<span class=sf-dump-str title=\"19 characters\">2025-07-04 06:19:47</span>\"
    \"<span class=sf-dump-key>updated_at</span>\" => \"<span class=sf-dump-str title=\"19 characters\">2025-07-04 06:19:47</span>\"
